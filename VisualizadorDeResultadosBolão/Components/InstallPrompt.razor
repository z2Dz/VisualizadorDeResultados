@inject IJSRuntime JS

@if (mostrarPopup)
{
    <div class="install-overlay">
        <div class="install-card">
            <h3>Instalar aplicativo?</h3>
            <p>Adicione o Visualizador de Resultados à tela inicial.</p>

            <div class="install-actions">
                <button class="install-btn primary" @onclick="Instalar">
                    Instalar
                </button>

                <button class="install-btn secondary" @onclick="Fechar">
                    Agora não
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool mostrarPopup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var instalado = await JS.InvokeAsync<bool>("pwaInstall.isInstalled");

            if (instalado)
                return;

            for (int i = 0; i < 20; i++)
            {
                var podeInstalar = await JS.InvokeAsync<bool>("pwaInstall.canInstall");

                if (podeInstalar)
                {
                    mostrarPopup = true;
                    StateHasChanged();
                    return;
                }

                await Task.Delay(300);
            }
        }
    }

    private async Task Instalar()
    {
        var instalado = await JS.InvokeAsync<bool>("pwaInstall.promptInstall");
        mostrarPopup = false;
    }

    private void Fechar()
    {
        mostrarPopup = false;
    }
}