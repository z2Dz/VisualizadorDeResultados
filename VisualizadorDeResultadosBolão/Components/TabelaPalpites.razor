@using VisualizadorDeResultadosBolão.Models

<div class="palpites-card">

    <!-- BUSCA -->
    <div class="busca-jogador-box">
        <input type="text"
               placeholder="Pesquisar jogador..."
               class="busca-jogador-input"
               @bind="filtroJogador"
               @bind:event="oninput" />
    </div>

    <div class="palpites-wrapper">
        <table class="palpites-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th class="jogador-col">Jogador</th>

                    @foreach (var jogo in Jogos)
                    {
                        <th>
                            <span class="jogo-confronto">@jogo.MandanteSigla x @jogo.VisitanteSigla</span>
                            @if (jogo.GolsMandante.HasValue && jogo.GolsVisitante.HasValue)
                            {
                                <span class="jogo-placar-real">@jogo.GolsMandante x @jogo.GolsVisitante</span>
                            }
                        </th>
                    }

                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var jogador in LinhasFiltradas)
                {
                    <tr class="palpites-row @GetClasseLinha(jogador.PosicaoPontos)">
                        <td class="posicao-col palpites-cell @GetClasseRank(jogador.PosicaoPontos)">@jogador.Posicao</td>
                        <td class="jogador-col palpites-cell">@jogador.Nome</td>

                        @foreach (var jogo in Jogos)
                        {
                            var palpite = jogador.Palpites.FirstOrDefault(p => p.RodadaJogoId == jogo.RodadaJogoId);

                            <td class="palpites-cell">
                                <span class="palpite @(GetClassePalpite(palpite))">
                                    @(palpite?.PalpiteLabel ?? "-")
                                </span>
                            </td>
                        }

                        <td class="total-col palpites-cell">@jogador.Total</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- RODAPÉ -->
    <div class="palpites-footer">
        <div class="footer-legenda">
            <div class="legenda-item">
                <span class="legenda-cor verde"></span>
                <span>= +3 Pontos</span>
            </div>

            <div class="legenda-item">
                <span class="legenda-cor amarelo"></span>
                <span>= +1 Ponto</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<PalpiteModel> Palpites { get; set; } = new();

    [Parameter]
    public List<RodadaJogoModel> Jogos { get; set; } = new();

    private string filtroJogador = "";

    private List<LinhaJogador> Linhas
    {
        get
        {
            var ordenados = Palpites
                .GroupBy(p => new { p.JogadoresId, p.JogadoresNome })
                .Select(g => new LinhaJogador
                {
                    Nome = g.Key.JogadoresNome,
                    Palpites = g.ToList(),
                    Total = g.Sum(x => x.PalpiteTotalPontos ?? 0)
                })
                .OrderByDescending(x => x.Total)
                .ThenBy(x => x.Nome)
                .ToList();

            // Índice sequencial exibido na coluna "#" (1, 2, 3, 4...),
            // mesmo quando há empate de pontos.
            for (var i = 0; i < ordenados.Count; i++)
            {
                ordenados[i].Posicao = i + 1;
            }

            // Ranking por pontuação (empatados dividem a mesma posição:
            // 1, 2, 2, 2, 3, 3...), usado só para colorir ouro/prata/bronze.
            // Conta apenas quantos valores de pontuação distintos já
            // apareceram, sem pular números por causa de empates.
            var posicaoPontosAtual = 0;
            int? totalAnterior = null;

            for (var i = 0; i < ordenados.Count; i++)
            {
                if (totalAnterior is null || ordenados[i].Total != totalAnterior)
                {
                    posicaoPontosAtual++;
                    totalAnterior = ordenados[i].Total;
                }

                ordenados[i].PosicaoPontos = posicaoPontosAtual;
            }

            return ordenados;
        }
    }

    private List<LinhaJogador> LinhasFiltradas =>
        string.IsNullOrWhiteSpace(filtroJogador)
            ? Linhas
            : Linhas
                .Where(x => x.Nome.Contains(filtroJogador, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private string GetClassePalpite(PalpiteModel? palpite)
    {
        if (palpite == null)
            return "";

        return palpite.PalpiteTotalPontos switch
        {
            3 => "certo",
            1 => "pontual",
            _ => ""
        };
    }

    private string GetClasseLinha(int posicao) => posicao switch
    {
        1 => "linha-ouro",
        2 => "linha-prata",
        3 => "linha-bronze",
        _ => ""
    };

    private string GetClasseRank(int posicao) => posicao switch
    {
        1 => "rank-1",
        2 => "rank-2",
        3 => "rank-3",
        _ => ""
    };

    private class LinhaJogador
    {
        public int Posicao { get; set; }
        public int PosicaoPontos { get; set; }
        public string Nome { get; set; } = "";
        public int Total { get; set; }
        public List<PalpiteModel> Palpites { get; set; } = new();
    }
}