@inject IJSRuntime JS

<select class="theme-select" value="@temaAtual" @onchange="OnThemeChanged">
    @foreach (var tema in temas)
    {
        <option value="@tema.Id">@tema.Label</option>
    }
</select>

@code {
    private List<TemaOpcao> temas = new();
    private string temaAtual = "Minimalista";

    protected override async Task OnInitializedAsync()
    {
        temas = await JS.InvokeAsync<List<TemaOpcao>>("themeManager.getThemes");
        temaAtual = await JS.InvokeAsync<string>("themeManager.loadTheme");
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        temaAtual = e.Value?.ToString() ?? "Minimalista";
        await JS.InvokeVoidAsync("themeManager.setTheme", temaAtual);
    }

    private class TemaOpcao
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
    }
}
